# ==================== User Data (per-user memory dirs) ====================
# The backend creates a directory per username at the repo root. These contain
# personal learning history and must never be committed.
testuser/
IT Tutor/
AI Secuirity/
AI Security/

# Generic safety net: any folder containing a memory/ subdirectory is user data.
# (Keep specific entries above; add new usernames here as they appear.)
*/memory/
*/lesson_plans/
*/progress.json

