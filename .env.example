# ==================== Jarvis AI Tutor - Environment ====================
# Copy this file to .env and adjust values for your environment.
# Note: the current backend reads these as constants in backend/main.py.
# If you wire them up via os.getenv(), they will take effect automatically.

# ---------- Ollama ----------
# URL of the local Ollama server. Default is the Ollama install default.
OLLAMA_URL=http://localhost:11434

# Model tag to use for all generation. Must already be pulled
# via `ollama pull <model>`.
OLLAMA_MODEL=qwen2.5:7b-instruct

# Sampling temperature defaults (optional overrides)
# OLLAMA_TEMPERATURE_ASSESSMENT=0.3
# OLLAMA_TEMPERATURE_TEACHING=0.7

# ---------- Backend server ----------
# Host interface to bind. Use 0.0.0.0 for LAN access, 127.0.0.1 for local-only.
HOST=0.0.0.0

# Port the FastAPI server listens on.
PORT=8000

# ---------- Storage ----------
# Root directory where per-user folders (memory/, lesson_plans/, progress.json)
# are created. Must be writable by the process running the backend.
BASE_DIR=D:/ai/ai-tutor

# ---------- CORS ----------
# Comma-separated list of allowed origins. Use * for fully open (current default).
CORS_ALLOW_ORIGINS=*
